<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IdleBar.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Frontier/**/*.cs" Link="Frontier/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Scene/**/*.cs" Link="Scene/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Ui/NumberFormat.cs" Link="Ui/NumberFormat.cs" />
    <Compile Include="../../src/Desktop/ScreenFit.cs" Link="Desktop/ScreenFit.cs" />
    <Compile Include="../../src/Online/FrontierLoader.cs;../../src/Online/LoadPlan.cs;../../src/Online/LocalSave.cs;../../src/Online/FrontierData.cs;../../src/Online/SaveArguments.cs;../../src/Online/SocialData.cs;../../src/Online/ItemData.cs;../../src/Online/ShopData.cs;../../src/Online/ResearchData.cs" Link="Online/%(Filename)%(Extension)" />
    <Compile Include="../../src/Cloud/SupabaseJson.cs" Link="Cloud/SupabaseJson.cs" />
    <Compile Include="../../src/Cloud/ReleaseInfo.cs;../../src/Cloud/ReleaseAsset.cs" Link="Cloud/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/PackageSwap.cs" Link="Desktop/PackageSwap.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
